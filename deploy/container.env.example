# Copy once to /usr/local/dev/workstation-deploy/.env. Keep secrets outside Git.
# These three settings must be plain values, without quotes or spaces.
WORKSTATION_DATA_DIR=/usr/local/dev/workstation-data
WORKSTATION_BIND=127.0.0.1
WORKSTATION_PORT=3001
BACKUP_RETENTION_DAYS=30
# Optional server-only provider keys / GitHub / knowledge-sync settings:
# GITHUB_TOKEN=
# KNOWLEDGE_SYNC_TOKEN_HASH=
