generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String        @map("password_hash")
  isActive     Boolean       @default(true) @map("is_active")
  lastLoginAt  DateTime?     @map("last_login_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  sessions     Session[]
  siteVersions SiteVersion[]

  @@map("users")
}

model Session {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model SiteVersion {
  id          String    @id @default(cuid())
  version     Int       @unique
  status      String    @default("DRAFT")
  content     Json
  createdById String?   @map("created_by_id")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@map("site_versions")
}

model Asset {
  id               String   @id @default(cuid())
  originalFilename String   @map("original_filename")
  storagePath      String   @unique @map("storage_path")
  mimeType         String   @map("mime_type")
  width            Int?
  height           Int?
  sizeBytes        Int      @map("size_bytes")
  sha256           String
  altTextZh        String?  @map("alt_text_zh")
  altTextEn        String?  @map("alt_text_en")
  isReferenced     Boolean  @default(false) @map("is_referenced")
  createdAt        DateTime @default(now()) @map("created_at")
  draftAttachments KnowledgePublicationDraftAttachment[]

  @@index([sha256])
  @@map("assets")
}

model ResumeFile {
  id               String   @id @default(cuid())
  locale           String   @unique
  originalFilename String   @map("original_filename")
  storagePath      String   @unique @map("storage_path")
  mimeType         String   @map("mime_type")
  sizeBytes        Int      @map("size_bytes")
  sha256           String
  visibility       String   @default("PRIVATE")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([visibility, locale])
  @@map("resume_files")
}

model CareerActivity {
  id         String   @id @default(cuid())
  titleZh    String   @map("title_zh")
  titleEn    String?  @map("title_en")
  summaryZh  String   @map("summary_zh")
  summaryEn  String?  @map("summary_en")
  occurredAt DateTime @map("occurred_at")
  visibility String   @default("PRIVATE")
  featured   Boolean  @default(false)
  linkUrl    String?  @map("link_url")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([visibility, featured, occurredAt])
  @@map("career_activities")
}

model PortfolioProject {
  id               String    @id @default(cuid())
  slug             String    @unique
  titleZh          String    @map("title_zh")
  titleEn          String?   @map("title_en")
  summaryZh        String    @map("summary_zh")
  summaryEn        String?   @map("summary_en")
  contextZh        String    @map("context_zh")
  contextEn        String?   @map("context_en")
  responsibilityZh String    @map("responsibility_zh")
  responsibilityEn String?   @map("responsibility_en")
  challengeZh      String    @map("challenge_zh")
  challengeEn      String?   @map("challenge_en")
  approachZh       String    @map("approach_zh")
  approachEn       String?   @map("approach_en")
  resultZh         String    @map("result_zh")
  resultEn         String?   @map("result_en")
  coverImage       String?   @map("cover_image")
  coverAltZh       String?   @map("cover_alt_zh")
  coverAltEn       String?   @map("cover_alt_en")
  technologies     Json
  links            Json
  skillEvidence    SkillEvidence[]
  visibility       String    @default("PRIVATE")
  featured         Boolean   @default(false)
  sortOrder        Int       @default(0) @map("sort_order")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([visibility, featured, sortOrder])
  @@map("portfolio_projects")
}

model ExperienceRecord {
  id             String    @id @default(cuid())
  kind           String
  organizationZh String    @map("organization_zh")
  organizationEn String?   @map("organization_en")
  titleZh        String    @map("title_zh")
  titleEn        String?   @map("title_en")
  descriptionZh  String    @map("description_zh")
  descriptionEn  String?   @map("description_en")
  locationZh     String?   @map("location_zh")
  locationEn     String?   @map("location_en")
  linkUrl        String?   @map("link_url")
  startedAt      DateTime  @map("started_at")
  endedAt        DateTime? @map("ended_at")
  isCurrent      Boolean   @default(false) @map("is_current")
  visibility     String    @default("PRIVATE")
  featured       Boolean   @default(false)
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([visibility, featured, isCurrent, sortOrder, startedAt])
  @@map("experience_records")
}

model SkillArea {
  id             String        @id @default(cuid())
  nameZh         String        @map("name_zh")
  nameEn         String?       @map("name_en")
  descriptionZh  String        @map("description_zh")
  descriptionEn  String?       @map("description_en")
  visibility     String        @default("PRIVATE")
  sortOrder      Int           @default(0) @map("sort_order")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  skills         Skill[]

  @@index([visibility, sortOrder])
  @@map("skill_areas")
}

model Skill {
  id          String          @id @default(cuid())
  areaId      String          @map("area_id")
  nameZh      String          @map("name_zh")
  nameEn      String?         @map("name_en")
  summaryZh   String          @map("summary_zh")
  summaryEn   String?         @map("summary_en")
  visibility  String          @default("PRIVATE")
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  area        SkillArea       @relation(fields: [areaId], references: [id], onDelete: Cascade)
  evidence    SkillEvidence[]

  @@index([areaId, sortOrder])
  @@index([visibility, sortOrder])
  @@map("skills")
}

model SkillEvidence {
  id         String           @id @default(cuid())
  skillId    String           @map("skill_id")
  kind       String
  projectId  String?          @map("project_id")
  titleZh    String?          @map("title_zh")
  titleEn    String?          @map("title_en")
  url        String?
  sortOrder  Int              @default(0) @map("sort_order")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  skill      Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  project    PortfolioProject? @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([skillId, sortOrder])
  @@index([projectId])
  @@map("skill_evidence")
}

model OkrCycle {
  id         String      @id @default(cuid())
  nameZh     String      @map("name_zh")
  nameEn     String?     @map("name_en")
  type       String
  startDate  DateTime    @map("start_date")
  endDate    DateTime    @map("end_date")
  status     String      @default("DRAFT")
  visibility String      @default("PRIVATE")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  objectives Objective[]
  reviews    Review[]

  @@index([status, startDate, endDate])
  @@map("okr_cycles")
}

model Objective {
  id          String      @id @default(cuid())
  cycleId     String      @map("cycle_id")
  titleZh     String      @map("title_zh")
  titleEn     String?     @map("title_en")
  descriptionZh String?   @map("description_zh")
  descriptionEn String?   @map("description_en")
  status      String      @default("NOT_STARTED")
  visibility  String      @default("PRIVATE")
  sortOrder   Int         @default(0) @map("sort_order")
  startDate   DateTime?   @map("start_date")
  endDate     DateTime?   @map("end_date")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  cycle       OkrCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  keyResults  KeyResult[]
  reviews     Review[]

  @@index([cycleId, sortOrder])
  @@index([visibility, status])
  @@map("objectives")
}

model KeyResult {
  id             String             @id @default(cuid())
  objectiveId    String             @map("objective_id")
  titleZh        String             @map("title_zh")
  titleEn        String?            @map("title_en")
  descriptionZh  String?            @map("description_zh")
  descriptionEn  String?            @map("description_en")
  progressMode   String             @map("progress_mode")
  startValue     Float?             @map("start_value")
  currentValue   Float?             @map("current_value")
  targetValue    Float?             @map("target_value")
  unit           String?
  manualProgress Float?             @map("manual_progress")
  weight         Float              @default(1)
  status         String             @default("NOT_STARTED")
  sortOrder      Int                @default(0) @map("sort_order")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  objective      Objective          @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  progressUpdates KrProgressUpdate[]
  actionItems     ActionItem[]

  @@index([objectiveId, sortOrder])
  @@map("key_results")
}

model ActionItem {
  id                 String    @id @default(cuid())
  keyResultId        String    @map("key_result_id")
  titleZh            String    @map("title_zh")
  titleEn            String?   @map("title_en")
  status             String    @default("TODO")
  dueDate            DateTime? @map("due_date")
  sortOrder          Int       @default(0) @map("sort_order")
  recurrenceType     String    @default("NONE") @map("recurrence_type")
  recurrenceInterval Int       @default(1) @map("recurrence_interval")
  recurrenceDays     String?   @map("recurrence_days")
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  keyResult          KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)

  @@index([keyResultId, sortOrder])
  @@index([status, dueDate])
  @@map("action_items")
}

model KrProgressUpdate {
  id             String    @id @default(cuid())
  keyResultId    String    @map("key_result_id")
  currentValue   Float?    @map("current_value")
  manualProgress Float?    @map("manual_progress")
  calculatedProgress Float @map("calculated_progress")
  noteZh         String?   @map("note_zh")
  noteEn         String?   @map("note_en")
  recordedAt     DateTime  @default(now()) @map("recorded_at")
  keyResult      KeyResult @relation(fields: [keyResultId], references: [id], onDelete: Cascade)

  @@index([keyResultId, recordedAt])
  @@map("kr_progress_updates")
}

model Review {
  id            String     @id @default(cuid())
  cycleId       String     @map("cycle_id")
  objectiveId   String?    @map("objective_id")
  achievementsZh String    @map("achievements_zh")
  achievementsEn String?   @map("achievements_en")
  problemsZh    String     @map("problems_zh")
  problemsEn    String?    @map("problems_en")
  lessonsZh     String     @map("lessons_zh")
  lessonsEn     String?    @map("lessons_en")
  nextActionsZh String     @map("next_actions_zh")
  nextActionsEn String?    @map("next_actions_en")
  score         Float?
  visibility    String     @default("PRIVATE")
  reviewedAt    DateTime   @default(now()) @map("reviewed_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  cycle         OkrCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  objective     Objective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  @@index([cycleId, reviewedAt])
  @@index([objectiveId])
  @@index([visibility])
  @@map("reviews")
}

model KnowledgeVault {
  id                String          @id @default(cuid())
  name              String
  rootPath          String          @unique @map("root_path")
  enabled           Boolean         @default(true)
  ignorePatterns    Json            @map("ignore_patterns")
  lastScanStatus    String          @default("NEVER") @map("last_scan_status")
  lastScannedAt     DateTime?       @map("last_scanned_at")
  lastScanFileCount Int             @default(0) @map("last_scan_file_count")
  lastScanError     String?         @map("last_scan_error")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  notes             KnowledgeNote[]
  noteLinks         KnowledgeNoteLink[]
  sourceRevisions   KnowledgeSourceRevision[]
  syncReports       KnowledgeSyncReport[]

  @@index([enabled, name])
  @@map("knowledge_vaults")
}

model KnowledgeNote {
  id               String         @id @default(cuid())
  vaultId          String         @map("vault_id")
  relativePath     String         @map("relative_path")
  fileName         String         @map("file_name")
  directoryPath    String         @map("directory_path")
  sizeBytes        Int            @map("size_bytes")
  modifiedAt       DateTime       @map("modified_at")
  contentHash      String         @map("content_hash")
  visibility       String         @default("PRIVATE")
  hasFrontmatter   Boolean        @default(false) @map("has_frontmatter")
  hasWikilinks     Boolean        @default(false) @map("has_wikilinks")
  hasEmbeds        Boolean        @default(false) @map("has_embeds")
  hasCallouts      Boolean        @default(false) @map("has_callouts")
  hasDataview      Boolean        @default(false) @map("has_dataview")
  hasTasks         Boolean        @default(false) @map("has_tasks")
  isMoc            Boolean        @default(false) @map("is_moc")
  frontmatterJson  String?        @map("frontmatter_json")
  indexedAt        DateTime       @map("indexed_at")
  vault            KnowledgeVault @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  @@unique([vaultId, relativePath])
  @@index([vaultId, directoryPath, fileName])
  @@index([contentHash])
  @@map("knowledge_notes")
}

model KnowledgeNoteLink {
  id                 String         @id @default(cuid())
  vaultId            String         @map("vault_id")
  kind               String         @default("LINK")
  sourceRelativePath String         @map("source_relative_path")
  targetRaw          String         @map("target_raw")
  targetRelativePath String?        @map("target_relative_path")
  targetHeading      String?        @map("target_heading")
  displayLabel       String?        @map("display_label")
  isResolved         Boolean        @default(false) @map("is_resolved")
  indexedAt          DateTime       @map("indexed_at")
  vault              KnowledgeVault @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  @@index([vaultId, sourceRelativePath])
  @@index([vaultId, targetRelativePath])
  @@index([vaultId, isResolved])
  @@map("knowledge_note_links")
}

model KnowledgeSourceRevision {
  id              String         @id @default(cuid())
  vaultId         String         @map("vault_id")
  relativePath    String         @map("relative_path")
  contentHash     String         @map("content_hash")
  markdown        String
  frontmatterJson String?        @map("frontmatter_json")
  origin          String         @default("LOCAL_SCAN")
  capturedAt      DateTime       @map("captured_at")
  vault           KnowledgeVault @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  draft           KnowledgePublicationDraft?

  @@unique([vaultId, relativePath, contentHash])
  @@index([vaultId, relativePath, capturedAt])
  @@map("knowledge_source_revisions")
}

model KnowledgePublicationDraft {
  id               String                  @id @default(cuid())
  sourceRevisionId String                  @unique @map("source_revision_id")
  sourceHash       String                  @map("source_hash")
  markdown         String
  title            String
  summary          String?
  tags             Json
  status           String                  @default("DRAFT")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  sourceRevision   KnowledgeSourceRevision @relation(fields: [sourceRevisionId], references: [id], onDelete: Restrict)
  article          KnowledgeArticle?
  attachments      KnowledgePublicationDraftAttachment[]

  @@index([status, updatedAt])
  @@map("knowledge_publication_drafts")
}

model KnowledgeArticle {
  id               String                    @id @default(cuid())
  draftId          String                    @unique @map("draft_id")
  sourceRevisionId String                    @map("source_revision_id")
  sourceHash       String                    @map("source_hash")
  slug             String                    @unique
  markdown         String
  title            String
  summary          String?
  tags             Json
  publishedAt      DateTime                  @default(now()) @map("published_at")
  draft            KnowledgePublicationDraft @relation(fields: [draftId], references: [id], onDelete: Restrict)
  collections      KnowledgeCollectionArticle[]
  attachments      KnowledgeArticleAttachment[]

  @@index([publishedAt])
  @@map("knowledge_articles")
}

model KnowledgePublicationDraftAttachment {
  id        String                    @id @default(cuid())
  draftId   String                    @map("draft_id")
  target    String
  assetId   String                    @map("asset_id")
  createdAt DateTime                  @default(now()) @map("created_at")
  draft     KnowledgePublicationDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  asset     Asset                     @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([draftId, target])
  @@index([assetId])
  @@map("knowledge_publication_draft_attachments")
}

model KnowledgeArticleAttachment {
  id          String           @id
  articleId   String           @map("article_id")
  target      String
  storagePath String           @unique @map("storage_path")
  mimeType    String           @map("mime_type")
  sizeBytes   Int              @map("size_bytes")
  sha256      String
  createdAt   DateTime         @default(now()) @map("created_at")
  article     KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, target])
  @@index([sha256])
  @@map("knowledge_article_attachments")
}

model KnowledgeCollection {
  id          String                       @id @default(cuid())
  title       String
  description String?
  slug        String                       @unique
  visibility  String                       @default("PRIVATE")
  sortOrder   Int                          @default(0) @map("sort_order")
  createdAt   DateTime                     @default(now()) @map("created_at")
  updatedAt   DateTime                     @updatedAt @map("updated_at")
  articles    KnowledgeCollectionArticle[]

  @@index([visibility, sortOrder])
  @@map("knowledge_collections")
}

model KnowledgeCollectionArticle {
  collectionId String              @map("collection_id")
  articleId    String              @map("article_id")
  sortOrder    Int                 @default(0) @map("sort_order")
  collection   KnowledgeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  article      KnowledgeArticle    @relation(fields: [articleId], references: [id], onDelete: Restrict)

  @@id([collectionId, articleId])
  @@index([articleId])
  @@map("knowledge_collection_articles")
}

model KnowledgeSyncReport {
  id             String                @id @default(cuid())
  vaultId        String                @map("vault_id")
  scannedAt      DateTime              @map("scanned_at")
  addedCount     Int                   @default(0) @map("added_count")
  modifiedCount  Int                   @default(0) @map("modified_count")
  movedCount     Int                   @default(0) @map("moved_count")
  missingCount   Int                   @default(0) @map("missing_count")
  unchangedCount Int                   @default(0) @map("unchanged_count")
  createdAt      DateTime              @default(now()) @map("created_at")
  vault          KnowledgeVault        @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  changes        KnowledgeSyncChange[]

  @@index([vaultId, scannedAt])
  @@map("knowledge_sync_reports")
}

model KnowledgeSyncChange {
  id                   String              @id @default(cuid())
  reportId             String              @map("report_id")
  type                 String
  previousRelativePath String?             @map("previous_relative_path")
  currentRelativePath  String?             @map("current_relative_path")
  previousContentHash  String?             @map("previous_content_hash")
  currentContentHash   String?             @map("current_content_hash")
  previousModifiedAt   DateTime?           @map("previous_modified_at")
  currentModifiedAt    DateTime?           @map("current_modified_at")
  report               KnowledgeSyncReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, type])
  @@map("knowledge_sync_changes")
}
