# In production, point this at a persistent path outside the release directory.
DATABASE_URL="file:/var/lib/personal-workstation/workstation.db"
UPLOAD_DIR="/var/lib/personal-workstation/uploads"
BACKUP_DIR="/var/backups/personal-workstation"
# Optional for non-interactive deployment. Otherwise visit /admin once to initialize.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
